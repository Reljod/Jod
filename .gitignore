# Local, per-machine Claude Code settings — not shared policy.
.claude/settings.local.json

# install.sh's record of which version/ref is checked out. Only meaningful
# inside a `jod` toolkit checkout ($JOD_HOME) — never relevant in this repo.
.jod-version

# tests/e2e/run.sh's generated findings — regenerated on every run, not
# something to track in version control.
tests/e2e/gaps-report.md

# Rust build output. The leading slash pins the first to the workspace root,
# so every crate outside it needs naming — `apps/ios/src-tauri` is its own
# cargo workspace and drops a `target/` of its own.
/target
apps/ios/src-tauri/target/

# Benchmarks under research/ are standalone cargo crates, so each builds a
# `target/` the root rule cannot reach — one of them is 141 MB. The bench
# *source* is tracked, because a measurement nobody can re-run is an anecdote.
research/**/target/

# Web/desktop app build output and dependencies.
node_modules/
apps/desktop/dist/
apps/web/dist/
apps/ios/dist/

# Regenerated by tauri-build on every compile.
apps/desktop/src-tauri/gen/

# The Xcode project `tauri ios init` generates. Machine-specific (team ids,
# absolute paths) and reproducible from tauri.conf.json, so it is regenerated
# on the Mac that builds rather than tracked.
apps/ios/src-tauri/gen/
.env

# Python bytecode, from the browser MCP server and its tests.
__pycache__/
*.pyc
