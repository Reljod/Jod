{
  "name": "jod-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Taglish-aware push-to-talk dictation for CLI and coding harnesses",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "app": "./scripts/with-key.sh pnpm tauri dev",
    "app:build": "tauri build",
    "bench": "./scripts/with-key.sh node scripts/bench.mjs",
    "bench:top": "./scripts/with-key.sh node scripts/bench.mjs --top"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.1"
  }
}
