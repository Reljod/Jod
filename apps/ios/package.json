{
  "name": "jod-ios",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jod on iPhone — the jod tui conversation, with the desktop client's feel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
